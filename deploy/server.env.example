# backend/.env on a server. Copy it, fill the <...> values, and keep it out of git.
NODE_ENV=production
DATABASE_URL="mysql://<db user>:<db password>@127.0.0.1:3306/<db name>"

AUTH_MODE=jwt
# 64 random characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<random>
COOKIE_SECURE=on
DEMO_ADMIN_2FA_BYPASS_CODE=
DEV_TODAY=
DEV_TENANT_CODE=<the client's tenant code>
DEV_DEFAULT_USER=

PORT=3002
TRUST_PROXY=on
CORS_ORIGIN=https://<domain>
APP_URL=https://<domain>

UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=10485760

OUTBOX_DISPATCH=on
OUTBOX_INTERVAL_MS=5000

# Per client
SERVICE_MODULE=off
MES_TILE=on
WMS_URL=
WMS_EMAIL=
WMS_PASSWORD=
WMS_WEB_URL=
